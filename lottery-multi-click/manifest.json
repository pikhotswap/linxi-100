{
  "manifest_version": 3,
  "name": "一键连点器",
  "version": "1.0",
  "description": "一键自动点击按钮 N 次，免去重复点击",
  "content_scripts": [
    {
      "matches": [
        "https://test-sub2api.shengqainbang.cn/*",
        "https://k40.shengqainbang.cn/*",
        "https://sub.100xlabs.space/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
